---
// File: src/pages/about.astro
// About: who we are, how we work, who we work with and the trust facts (the former Trust, Method and
// Industries pages, condensed). Statuses only state what is true today.
import Layout from '../layouts/Layout.astro';
import ServiceArt from '../components/ServiceArt';
import { LEGAL_DOCS } from '../data/legal';

const principles = [
  { title: 'Senior practitioners only', text: 'No junior staff billed at senior rates.' },
  { title: 'Cyber security at the core', text: 'Control, evidence and audit trail under everything we do.' },
  { title: 'Lean overhead, honest pricing', text: 'No rotating account managers, no partner pyramid to feed.' },
  { title: 'Fixed fees where scope is clear', text: 'You know what it costs before we start.' },
  { title: 'Compliance by design', text: 'Risk registers, evidence and audit trails from week one.' },
  { title: 'Independent', text: 'We do not resell tools we cannot defend. No kickbacks.' },
];

const sectors = ['Technology', 'Professional Services', 'Financial Services', 'Healthcare', 'Corporate Services'];

const trust = [
  {
    name: 'Companies House',
    status: 'Active',
    detail: 'StackSolver UK Limited · No. 16227080 · England and Wales',
    link: 'https://find-and-update.company-information.service.gov.uk/company/16227080',
    linkLabel: 'Public registry',
  },
  {
    name: 'Cyber Essentials',
    status: 'In progress',
    detail: 'UK Government-backed certification. Badge published once issued.',
    link: 'https://www.ncsc.gov.uk/cyberessentials/overview',
    linkLabel: 'NCSC scheme',
  },
  {
    name: 'ICO registration',
    status: 'In progress',
    detail: 'Registration as a data controller. Number published once issued.',
    link: '/legal/ico-registration',
    linkLabel: 'See notice',
  },
];
const isExternal = (href: string) => href.startsWith('http');
---

<Layout
  title="About | StackSolver UK"
  description="StackSolver UK Limited is a Brighton-based consultancy for regulated industries. Cyber security is our specialty."
>
  <!-- Who we are -->
  <section class="relative overflow-hidden bg-white dark:bg-black">
    <div aria-hidden="true" class="pointer-events-none absolute -top-48 left-1/2 h-[480px] w-[900px] -translate-x-1/2 rounded-full bg-olive-500/10 blur-3xl"></div>
    <ServiceArt
      motif="shield"
      seedKey="about-hero"
      className="pointer-events-none absolute right-0 top-10 hidden h-80 w-[34rem] text-olive-600 opacity-50 dark:text-olive-400 lg:block [mask-image:radial-gradient(ellipse_70%_80%_at_65%_45%,black_40%,transparent_78%)]"
    />
    <div class="relative max-w-6xl mx-auto px-6 lg:px-8 pt-14 pb-16 lg:pt-24 lg:pb-24">
      <p class="text-xs font-mono uppercase tracking-widest text-olive-600 dark:text-olive-400">About</p>
      <h1 class="mt-3 max-w-3xl text-4xl md:text-6xl font-bold tracking-tight text-zinc-900 dark:text-white">A British consultancy with a clear specialty.</h1>
      <p class="mt-5 max-w-2xl text-lg text-zinc-600 dark:text-zinc-400">
        StackSolver UK Limited is a Brighton-based consultancy. Cyber security is our specialty.
      </p>
      <div class="mt-8 flex flex-wrap gap-2 text-sm">
        <span class="rounded-full border border-zinc-200 dark:border-zinc-800 px-3 py-1 text-zinc-600 dark:text-zinc-400">Brighton · London</span>
        <span class="rounded-full border border-zinc-200 dark:border-zinc-800 px-3 py-1 text-zinc-600 dark:text-zinc-400">United Kingdom · Europe · United States</span>
      </div>
    </div>
  </section>

  <!-- How we work -->
  <section class="border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950">
    <div class="max-w-6xl mx-auto px-6 lg:px-8 py-16">
      <p class="text-xs font-mono uppercase tracking-widest text-olive-600 dark:text-olive-400">How we work</p>
      <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {principles.map((p, i) => (
          <div class="rounded-2xl border border-zinc-200 bg-white p-6 transition-colors hover:border-olive-500/60 dark:border-zinc-800 dark:bg-black">
            <p class="font-mono text-xs text-olive-600 dark:text-olive-400">0{i + 1}</p>
            <h2 class="mt-2 text-lg font-semibold text-zinc-900 dark:text-white">{p.title}</h2>
            <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Who we work with -->
  <section id="sectors" class="scroll-mt-20 border-t border-zinc-200 dark:border-zinc-800 bg-white dark:bg-black">
    <div class="max-w-6xl mx-auto px-6 lg:px-8 py-16">
      <p class="text-xs font-mono uppercase tracking-widest text-olive-600 dark:text-olive-400">Who we work with</p>
      <h2 class="mt-2 text-2xl md:text-3xl font-bold tracking-tight text-zinc-900 dark:text-white">Regulated industries.</h2>
      <div class="mt-6 flex flex-wrap gap-2">
        {sectors.map((s) => (
          <span class="rounded-xl border border-zinc-200 dark:border-zinc-800 px-4 py-2.5 text-sm font-medium text-zinc-700 dark:text-zinc-300">{s}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Trust -->
  <section id="trust" class="scroll-mt-20 border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950">
    <div class="max-w-6xl mx-auto px-6 lg:px-8 py-16">
      <p class="text-xs font-mono uppercase tracking-widest text-olive-600 dark:text-olive-400">Trust</p>
      <h2 class="mt-2 text-2xl md:text-3xl font-bold tracking-tight text-zinc-900 dark:text-white">What we can show you today.</h2>
      <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
        {trust.map((t) => (
          <div class="flex flex-col rounded-2xl border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-black">
            <span class={`self-start rounded-full px-2.5 py-1 text-xs font-semibold ${t.status === 'Active' ? 'bg-olive-500/15 text-olive-700 dark:text-olive-400' : 'bg-amber-500/15 text-amber-700 dark:text-amber-400'}`}>{t.status}</span>
            <h3 class="mt-3 text-lg font-semibold text-zinc-900 dark:text-white">{t.name}</h3>
            <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{t.detail}</p>
            <a
              href={t.link}
              {...(isExternal(t.link) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              class="mt-auto pt-4 text-sm text-zinc-700 dark:text-zinc-300 underline underline-offset-4 hover:text-olive-600"
            >{t.linkLabel}</a>
          </div>
        ))}
        <div class="flex flex-col rounded-2xl border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-black">
          <span class="self-start rounded-full bg-olive-500/15 px-2.5 py-1 text-xs font-semibold text-olive-700 dark:text-olive-400">{LEGAL_DOCS.length} documents</span>
          <h3 class="mt-3 text-lg font-semibold text-zinc-900 dark:text-white">Policies and statements</h3>
          <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">Privacy, modern slavery, anti-bribery and more. Data Processing Agreement on request.</p>
          <a href="/legal" class="mt-auto pt-4 text-sm text-zinc-700 dark:text-zinc-300 underline underline-offset-4 hover:text-olive-600">Read them</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="border-t border-zinc-200 dark:border-zinc-800 bg-white dark:bg-black">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 py-16 text-center">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-zinc-900 dark:text-white">Need something for procurement?</h2>
      <p class="mt-3 text-zinc-600 dark:text-zinc-400">Security questionnaires, supplier onboarding forms: tell us what you need.</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-olive-500 text-zinc-900 font-semibold border border-olive-500 hover:bg-olive-600 transition-colors">Contact us <span aria-hidden="true">→</span></a>
        <a href="/services" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg text-zinc-900 dark:text-white font-medium border border-olive-500 hover:bg-olive-500/10 transition-colors">Our services</a>
      </div>
    </div>
  </section>
</Layout>
