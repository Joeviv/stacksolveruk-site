---
// File: src/pages/index.astro
// Home: the page builds itself from the visitor's choices (HomeExperience).
// Services listed in HIDDEN_SERVICES stay off the site.
import Layout from '../layouts/Layout.astro';
import HomeExperience from '../components/HomeExperience';
import { SERVICES_MENU } from '../data/menuData';
import { AREAS, HIDDEN_SERVICES, servicesForArea, validateGuide, type GuideService } from '../data/serviceGuide';

const seoTitle = "StackSolver UK | Cyber Security, Governance, Risk & Compliance Consultancy";
const seoDescription = "Independent cyber security, governance, risk and compliance consultancy based in Brighton. Serving the United Kingdom, Europe and the United States. Senior expertise. Lean delivery. Auditable by design.";
const seoKeywords = "Cyber Essentials Plus UK, Penetration Testing UK, vCISO UK, ISO 27001 UK, SOC 2, UK GDPR, NIS2 readiness, DORA compliance, third-party risk, business continuity, Claris FileMaker ERP, ERP consulting UK, HR support UK, Brighton consultancy";

const allServices: GuideService[] = SERVICES_MENU.flatMap((section) =>
  section.subsections.map((sub) => ({
    id: sub.id,
    title: sub.title,
    summary: sub.shortDescription,
    href: `/services#${sub.id}`,
    section: section.title,
    features: sub.features.map((f) => (typeof f === 'string' ? f : f.title)),
    plan: sub.implementationPlan.map((p) => ({ title: p.title, description: p.description })),
  })),
);
validateGuide(allServices.map((s) => s.id));
const homeServices = allServices.filter((s) => !HIDDEN_SERVICES.has(s.id));
const byId = new Map(homeServices.map((s) => [s.id, s]));
const columns = AREAS.map((area) => ({
  area,
  services: servicesForArea(area.id).map((id) => byId.get(id)).filter((s): s is GuideService => Boolean(s)),
}));
---

<Layout title={seoTitle} description={seoDescription} keywords={seoKeywords}>
  <HomeExperience client:load services={homeServices} />

  <!-- Everything we do: follows the area chosen above -->
  <section class="bg-zinc-50 dark:bg-zinc-950 border-t border-zinc-200 dark:border-zinc-800">
    <div class="max-w-6xl mx-auto px-6 lg:px-8 py-16">
      <p class="text-xs font-mono uppercase tracking-widest text-olive-600 dark:text-olive-400">Everything we do</p>
      <div class="mt-6 grid grid-cols-2 lg:grid-cols-6 gap-3">
        {columns.map(({ area, services }) => (
          <div
            data-guide-area={area.id}
            class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-black p-4 transition-all duration-300 data-[active=true]:border-olive-500 data-[active=true]:ring-1 data-[active=true]:ring-olive-500 data-[active=false]:opacity-50"
          >
            <h2 class="text-sm font-semibold text-zinc-900 dark:text-white">{area.label}</h2>
            <ul class="mt-3 space-y-1.5">
              {services.map((s) => (
                <li><a href={s.href} class="text-sm text-zinc-600 dark:text-zinc-400 hover:text-olive-600 dark:hover:text-olive-400">{s.title}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Who we are, short -->
  <section class="bg-white dark:bg-black border-t border-zinc-200 dark:border-zinc-800">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 py-16 text-center">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-zinc-900 dark:text-white">A British consultancy with a clear specialty.</h2>
      <p class="mt-4 text-lg text-zinc-600 dark:text-zinc-400">
        StackSolver UK Limited is a Brighton-based consultancy serving organisations across the United Kingdom,
        Europe and the United States. Cyber security is our specialty.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-olive-500 text-zinc-900 font-semibold border border-olive-500 hover:bg-olive-600 transition-colors">
          Contact us <span aria-hidden>→</span>
        </a>
        <a href="/about#trust" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-transparent text-zinc-900 dark:text-white font-medium border border-olive-500 hover:bg-olive-500/10 transition-colors">
          Trust Center
        </a>
      </div>
    </div>
  </section>

</Layout>

<script>
  // Highlight the chosen area in "Everything we do" and move it first.
  window.addEventListener('guide:area', (event) => {
    const chosen = (event as CustomEvent<string | null>).detail;
    document.querySelectorAll<HTMLElement>('[data-guide-area]').forEach((el) => {
      if (!chosen) {
        delete el.dataset.active;
        el.style.order = '';
        return;
      }
      const on = el.dataset.guideArea === chosen;
      el.dataset.active = String(on);
      el.style.order = on ? '-1' : '';
    });
  });
</script>
