---
// File: src/pages/404.astro
// Página propia para las rutas que no existen. Astro la emite como `dist/404.html`;
// Amplify la sirve con estado 404 cuando su regla `/<*>` apunta a `/404.html`.
// Antes se servía la portada entera (1,6 MB) con estado 404.
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found | StackSolver UK"
  description="The page you were looking for does not exist or has moved."
  robots="noindex, follow"
>
  <div class="min-h-[60vh] flex flex-col justify-center p-6 md:p-12">
    <div class="max-w-3xl mx-auto w-full text-center space-y-6">
      <p class="text-sm font-semibold tracking-widest uppercase text-olive-600 dark:text-olive-500">Error 404</p>
      <h1 class="text-4xl md:text-6xl font-bold text-zinc-900 dark:text-white tracking-tight">
        Page not found.
      </h1>
      <p class="text-zinc-600 dark:text-zinc-400 text-lg leading-relaxed">
        The page you were looking for does not exist or has moved.
      </p>
      <div class="flex flex-wrap justify-center gap-4 pt-4">
        <a href="/" class="px-6 py-3 rounded-lg bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 font-medium">Back to home</a>
        <a href="/contact" class="px-6 py-3 rounded-lg border border-zinc-300 dark:border-zinc-700 text-zinc-900 dark:text-white font-medium">Contact us</a>
      </div>
    </div>
  </div>
</Layout>
