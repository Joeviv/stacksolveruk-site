---
// File: src/pages/services/[sectionId]/index.astro
// Old section pages now point to their area on the Services page.
import Redirect from '../../../components/Redirect.astro';
import { SERVICES_MENU } from '../../../data/menuData';
import { AREAS, AREA_SERVICES } from '../../../data/serviceGuide';

export async function getStaticPaths() {
  const areaOf = new Map(AREAS.flatMap((a) => AREA_SERVICES[a.id].services.map((id) => [id, a.id] as const)));
  return SERVICES_MENU.map((section) => {
    const area = section.subsections.map((s) => areaOf.get(s.id)).find(Boolean);
    return { params: { sectionId: section.id }, props: { to: area ? `/services#${area}` : '/services' } };
  });
}

const { to } = Astro.props;
---

<Redirect to={to} />
