---
// File: src/pages/services/[sectionId]/[subsectionId].astro
// Old service pages now point to the service's card on the Services page.
import Redirect from '../../../components/Redirect.astro';
import { SERVICES_MENU } from '../../../data/menuData';
import { HIDDEN_SERVICES } from '../../../data/serviceGuide';

export async function getStaticPaths() {
  return SERVICES_MENU.flatMap((section) =>
    section.subsections.map((sub) => ({
      params: { sectionId: section.id, subsectionId: sub.id },
      props: { to: HIDDEN_SERVICES.has(sub.id) ? '/services' : `/services#${sub.id}` },
    })),
  );
}

const { to } = Astro.props;
---

<Redirect to={to} />
